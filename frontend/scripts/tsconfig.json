{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "seed-e2e.ts",
    "create-new-admin.ts"
  ],
  "exclude": [
    "../node_modules",
    "../src/**"
  ]
}