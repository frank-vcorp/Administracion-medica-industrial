exports[`portal-access-email-template > HTML incluye CTA, caja de credenciales y escapa contenido sensible 1`] = `
"<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Acceso al portal cliente</title>
</head>
<body style="margin:0;padding:0;background-color:#f9fafb;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif;color:#636569;">
  <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color:#f9fafb;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:560px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;overflow:hidden;">
          <tr>
            <td style="background:linear-gradient(135deg, #592c82 0%, #6b3d9e 100%);padding:28px 32px;">
              <p style="margin:0;font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:rgba(255,255,255,0.85);font-weight:600;">Soluciones Medico Empresariales</p>
              <h1 style="margin:8px 0 0;font-size:22px;line-height:1.3;font-weight:700;color:#ffffff;">Portal cliente</h1>
              <p style="margin:6px 0 0;font-size:13px;color:rgba(255,255,255,0.9);">Soluciones Medico Empresariales / Medicina Laboral</p>
            </td>
          </tr>
          <tr>
            <td style="padding:32px;">
              <p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#334155;">
                Se habilitó el acceso al portal para <strong style="color:#0f172a;">Sodexo Mexico</strong>.
                Utilice las credenciales siguientes para su primer ingreso.
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background:#f9fafb;border:1px solid #e2e8f0;border-radius:10px;margin:0 0 24px;">
                <tr>
                  <td style="padding:20px 22px;">
                    <p style="margin:0 0 4px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;color:#64748b;">Credenciales</p>
                    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin-top:12px;">
                      <tr>
                        <td style="padding:8px 0;font-size:13px;color:#64748b;width:140px;vertical-align:top;">Usuario</td>
                        <td style="padding:8px 0;font-size:15px;font-weight:600;color:#0f172a;font-family:ui-monospace,Menlo,Consolas,monospace;">portal@sodexo.mx</td>
                      </tr>
                      <tr>
                        <td style="padding:8px 0;font-size:13px;color:#64748b;vertical-align:top;border-top:1px solid #e2e8f0;">Contraseña temporal</td>
                        <td style="padding:8px 0;font-size:15px;font-weight:600;color:#0f172a;font-family:ui-monospace,Menlo,Consolas,monospace;border-top:1px solid #e2e8f0;">Tmp-9xK2mQ</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 28px;">
                <tr>
                  <td align="center">
                    <a href="https://app.medicaindustrial.com/login" style="display:inline-block;background-color:#00afaa;color:#ffffff;text-decoration:none;font-size:15px;font-weight:700;padding:14px 32px;border-radius:8px;mso-padding-alt:0;">Acceder al portal</a>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 12px;font-size:14px;line-height:1.6;color:#475569;font-weight:600;">Primer ingreso</p>
              <ul style="margin:0 0 20px;padding-left:20px;font-size:14px;line-height:1.65;color:#475569;">
                <li style="margin-bottom:6px;">Acepte los <a href="https://app.medicaindustrial.com/legal/terminos-portal" style="color:#592c82;">términos y condiciones</a> del portal.</li>
                <li style="margin-bottom:6px;">Acepte el <a href="https://app.medicaindustrial.com/legal/privacidad-portal" style="color:#592c82;">aviso de privacidad</a>.</li>
                <li>Defina una contraseña nueva de acceso.</li>
              </ul>

              <p style="margin:0;padding:14px 16px;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;font-size:13px;line-height:1.5;color:#92400e;">
                <strong>Seguridad:</strong> No comparta estas credenciales fuera de su organización. Si no solicitó este acceso, contacte a Soluciones Medico Empresariales.
              </p>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px;background:#f9fafb;border-top:1px solid #e2e8f0;">
              <p style="margin:0;font-size:11px;line-height:1.55;color:#94a3b8;text-align:center;">Soluciones Medico Empresariales — Circuito del Mesón #135, Col. Del Prado, C.P. 76030, Santiago de Querétaro — (442) 225-52-67 — www.medicaindustrial.com</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>"
`;
