.env*

# ARCH-20260513-15
# Respaldo: PROYECTO.md
.venv/
backend/.venv/
__pycache__/
*.pyc

# Basura del filesystem FUSE (metadata del IDE/Next dev server)
# No es código, no debe commitearse
.fuse_hidden*
.playwright-mcp/

# ARCH-20260630-02
# Auditoría NOVA: cookies de sesión y HTML descargado NO deben commitearse
# (contienen posibles secretos y son artefactos forenses efímeros)
context/audits/**/cookies.txt
context/audits/**/step*.json
context/audits/**/*.html
context/audits/**/pages/
.vercel
.env*.local

# ARCH-20260710-01
# Archivo 'production' (sin punto) creado por Vercel CLI contiene SECRETOS
# (DATABASE_URL, GEMINI_API_KEY, NEXTAUTH_SECRET, VERCEL_OIDC_TOKEN).
# NUNCA commitear. Renombrar a .env.production o mover fuera del repo.
production

# Configuración local del IDE Kilo (no debe viajar al repo)
.kilo/
